# Database
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Better Auth
# Generate a random 32+ character string: openssl rand -base64 32
BETTER_AUTH_SECRET="your-secret-key-min-32-chars"
# Your app's URL (e.g., https://matcha-tracker.yourname.workers.dev)
BETTER_AUTH_URL="http://localhost:3000"
# After your first sign-up, copy your user ID from the database and set it here
ADMIN_USER_ID="your-user-id"

# Telegram Bot (optional - for notifications)
# Create via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=""

# GitHub (for triggering scrape workflow)
GITHUB_TOKEN=""
GITHUB_REPO="your-username/matcha-tracker"
